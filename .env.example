# =============================================================================
#  Copy to .env and fill in. .env is gitignored and must never be committed.
#
#      cp .env.example .env
#
#  In the deployed topology none of these values exist as files: the pipeline
#  reads its connection strings from Azure Key Vault via the data factory's
#  managed identity. This file is the local-development equivalent.
# =============================================================================

# --- Local SQL Server 2022 container ----------------------------------------
# SQL Server rejects weak passwords at startup with a message that does not
# always make the reason obvious. It must be 8+ characters and contain three of:
# uppercase, lowercase, digit, non-alphanumeric.
MSSQL_SA_PASSWORD=ChangeMe_L0cal!Dev
MSSQL_HOST_PORT=1433
MSSQL_MEMORY_LIMIT_MB=2560

# --- Source: AdventureWorks2022 ---------------------------------------------
ETL_SOURCE_SERVER=localhost,1433
ETL_SOURCE_DATABASE=AdventureWorks2022
ETL_SOURCE_USER=sa
ETL_SOURCE_PASSWORD=ChangeMe_L0cal!Dev

# --- Target: SalesReportingDW ------------------------------------------------
ETL_TARGET_SERVER=localhost,1433
ETL_TARGET_DATABASE=SalesReportingDW
ETL_TARGET_USER=sa
ETL_TARGET_PASSWORD=ChangeMe_L0cal!Dev

# ODBC driver name as registered on this machine. Quoted because it contains
# spaces and this file is sourced by the shell scripts in scripts/.
# macOS/Linux (Homebrew or apt): "ODBC Driver 18 for SQL Server"
# Windows may still have 17 installed: "ODBC Driver 17 for SQL Server"
ETL_ODBC_DRIVER="ODBC Driver 18 for SQL Server"

# The local container presents a self-signed certificate, so certificate
# validation has to be relaxed for local development only.
# Against Azure SQL Database set this to "no" -- its certificate is valid, and
# trusting any certificate there would defeat TLS entirely.
ETL_TRUST_SERVER_CERTIFICATE=yes

# --- Alerting ----------------------------------------------------------------
# HTTPS endpoint to POST the failure payload to. In Azure this is the callback
# URL of the Logic App in adf/alerts/ -- it embeds a SAS signature, so treat it
# as a secret. Leave blank to log alerts to the console and to etl.etl_alert
# without attempting delivery.
ETL_ALERT_WEBHOOK_URL=

# Where alert payloads are written when no webhook is configured, so that a run
# performed offline still leaves the same evidence trail.
ETL_ALERT_LOG_DIR=reports/alerts

# --- Run behaviour -----------------------------------------------------------
# Rows per batch on the bulk insert into staging.
ETL_BATCH_SIZE=5000
